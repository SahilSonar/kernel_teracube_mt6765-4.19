CONFIG_ARCH_MTK_PROJECT="emerald"
CONFIG_CUSTOM_KERNEL_IMGSENSOR="s5k3l6_mipi_raw hi846_mipi_raw hi846_2lane_mipi_raw"
CONFIG_CUSTOM_KERNEL_LCM="icnl9911sac_6735_dsi_yk6xx ili9881d_6735_dsi_yk6xx ili9882_6735_dsi_yk6xx"
CONFIG_FPC_FINGERPRINT=y
CONFIG_HAVE_MTK_ENABLE_GENIEZONE=y
CONFIG_HAVE_MTK_GZ_LOG=y
# CONFIG_MICROTRUST_DEBUG is not set
CONFIG_MICROTRUST_DYNAMIC_CORE=y
CONFIG_MICROTRUST_FP_DRIVER=y
CONFIG_MICROTRUST_KEYMASTER_DRIVER=y
CONFIG_MICROTRUST_TEE_SUPPORT=y
CONFIG_MICROTRUST_TEE_VERSION="400"
# CONFIG_MICROTRUST_TEST_DRIVERS is not set
# CONFIG_MICROTRUST_TZDRIVER_DYNAMICAL_DEBUG is not set
CONFIG_MICROTRUST_TZ_DRIVER=y
# CONFIG_MICROTRUST_TZ_DRIVER_MTK_TRACING is not set
# CONFIG_MICROTRUST_TZ_LOG is not set
# CONFIG_MICROTRUST_UNITTEST_SUPPORT is not set
CONFIG_MICROTRUST_VFS_DRIVER=y
CONFIG_MMC_CRYPTO_LEGACY=y
CONFIG_MTK_CAM_GENIEZONE_SUPPORT=y
CONFIG_MTK_CAM_SECURITY_SUPPORT=y
# CONFIG_MTK_DRM_KEY_MNG_SUPPORT is not set
CONFIG_MTK_ENABLE_GENIEZONE=y
CONFIG_MTK_FINGERPRINT_SUPPORT=y
CONFIG_MTK_GZ_IRQ=y
CONFIG_MTK_GZ_KREE=y
CONFIG_MTK_GZ_LOG=y
CONFIG_MTK_GZ_MAIN=y
CONFIG_MTK_GZ_VIRTIO=y
CONFIG_MTK_GZ_VIRTIO_IPC=y
CONFIG_MTK_PROT_MEM_SUPPORT=y
CONFIG_MTK_SECURE_MEM_SUPPORT=y
# CONFIG_MTK_SEC_VIDEO_PATH_SUPPORT is not set
# CONFIG_MTK_TEE_GP_SUPPORT is not set
CONFIG_MTK_TEE_SANITY=y
CONFIG_MTK_TRUSTED_MEMORY_SUBSYSTEM=y
CONFIG_TRUSTY_INTERRUPT_FIQ_ONLY=y
CONFIG_TRUSTY_INTERRUPT_MAP=y
CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE_NAMES="mediatek/emerald"
